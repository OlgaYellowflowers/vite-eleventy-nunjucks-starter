{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "$": "readonly",
    "jQuery": "readonly"
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  }
}